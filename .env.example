# ─── Coordinador ───────────────────────────────────────────────
NODE_ID=A                    # Identificador único del nodo (A, B, C, D, E…)
PORT=3001                    # Puerto HTTP del coordinador
PEERS=                       # URLs iniciales separadas por comas (ej: http://localhost:3002,http://localhost:3003)

# ─── Timing Preset ─────────────────────────────────────────────
# Opciones: "lan" (localhost / pruebas) | "wan" (ngrok / aula)
TIMING_PRESET=lan

# ─── Worker ────────────────────────────────────────────────────
WORKER_PORT=4001             # Puerto HTTP del worker
WORKER_NAME=Worker1          # Nombre del worker en el naming service
COORDINATORS=http://localhost:3001,http://localhost:3002,http://localhost:3003
